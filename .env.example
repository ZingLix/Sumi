DATABASE_URL=postgres://sumi_app:change-me@127.0.0.1:5432/sumi
SUMI_BIND=127.0.0.1:8080
SUMI_BASE_URL=https://sumi.example.com
# Optional subpath: https://example.com/sumi (MCP becomes /sumi/mcp).
# Legacy SUMI_RESOURCE_URL remains supported; set only one unless they agree.
SUMI_OAUTH_ISSUER=https://auth.example.com/
SUMI_OAUTH_JWKS_FILE=/absolute/path/to/public-jwks.json
RUST_LOG=sumi=info,tower_http=info
