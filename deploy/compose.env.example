# Generate two different passwords with: openssl rand -hex 32
SUMI_DB_ADMIN_PASSWORD=change-me
SUMI_DB_APP_PASSWORD=change-me
# Public address, excluding /mcp. An optional path prefix is supported.
SUMI_BASE_URL=https://ledger.example.com
SUMI_PORT=8080
SUMI_OAUTH_ISSUER=https://auth.example.com/
# Public JWKS from your OAuth authorization server, readable by container UID 10001.
SUMI_OAUTH_JWKS_HOST_FILE=./.local/public-jwks.json
RUST_LOG=sumi=info,tower_http=info
